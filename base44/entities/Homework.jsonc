{
  "name": "Homework",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "lesson_title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_review",
        "reviewed"
      ],
      "default": "not_started"
    },
    "answer_text": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "feedback": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "student_email": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "status",
    "student_email"
  ]
}